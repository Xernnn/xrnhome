{
  "expo": {
    "name": "xrnhome",
    "slug": "xrnhome",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAFA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xern.xrnhome",
      "infoPlist": {
        "NSCameraUsageDescription": "xrnhome needs access to your camera so you can take photos of your items.",
        "NSPhotoLibraryUsageDescription": "xrnhome needs access to your photo library so you can choose photos of your items."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "package": "com.xern.xrnhome",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "xrnhome needs access to your photos so you can attach images to your items.",
          "cameraPermission": "xrnhome needs access to your camera so you can take photos of your items.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
